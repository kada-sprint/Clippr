generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id
  email       String
  displayName String    @map("display_name")
  avatarUrl   String?   @map("avatar_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  projects    Project[]

  @@map("users")
}

model Project {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id")
  sourceVideoPath    String?   @map("source_video_path")
  selectedLayout     String?   @map("selected_layout")
  customVocabulary   String    @default("") @map("custom_vocabulary")
  status             String    @default("idle")
  processingStage    String?   @map("processing_stage")
  transcriptJson     Json?     @map("transcript_json") @db.JsonB
  lastEditActivityAt DateTime? @map("last_edit_activity_at") @db.Timestamptz(3)
  sourceExpiresAt    DateTime? @map("source_expires_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  clips              Clip[]

  @@index([userId, createdAt])
  @@index([sourceExpiresAt])
  @@map("projects")
}

enum SubtitleStyle {
  clean
  active_word_highlight
}

model Clip {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  title             String
  subtitleStyle     SubtitleStyle @default(clean) @map("subtitle_style")
  startTime         Decimal   @map("start_time") @db.Decimal(10, 3)
  endTime           Decimal   @map("end_time") @db.Decimal(10, 3)
  transcriptJson    Json      @map("transcript_json") @db.JsonB
  conceptScore      Decimal   @map("concept_score") @db.Decimal(4, 3)
  pedagogicalReason String    @map("pedagogical_reason")
  clipVideoPath     String?   @map("clip_video_path")
  srtPath           String?   @map("srt_path")
  status            String    @default("pending")
  renderedAt        DateTime? @map("rendered_at") @db.Timestamptz(3)
  exportExpiresAt   DateTime? @map("export_expires_at") @db.Timestamptz(3)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([exportExpiresAt])
  @@map("clips")
}
