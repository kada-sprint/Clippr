PORT=3000
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=cuplik-local
FRONTEND_ORIGIN=http://localhost:5173
# Private Cloudflare R2 bucket (S3-compatible). Never expose these values to Vite.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Absolute path to backend/ directory. Used to resolve relative media paths in DB.
# In Docker this is set to /app/backend; locally it defaults to the backend/ folder.
# MEDIA_ROOT=
GOOGLE_CLIENT_ID=
# Copy the Aiven URI locally. URL-encode special characters in the password.
# This project uses Prisma 6: require TLS AND validate certificates.
# sslcert is relative to backend/prisma/, so ../certs/ca.pem is backend/certs/ca.pem.
# Keep the existing shared schema for read-only inspection; do not migrate it.
# sslrootcert is the file containing the trusted CA bundle; relative paths are resolved from backend/prisma/.
DATABASE_URL=
SESSION_SECRET=
# Konfigurasi Speech-to-Text (Elice Model Library / Whisper)
ELICE_API_KEY=
ELICE_API_BASE_URL=
STT_MODEL="whisper-large-v3"

# LLM provider for curation (GPT-5.6 Luna via OpenAI direct)
LLM_API_KEY= 
LLM_BASE_URL=
LLM_MODEL="gpt-5.6-luna"

# Path binary FFmpeg & FFprobe (opsional, jika tidak menggunakan modul ffmpeg-static / @ffprobe-installer/ffprobe)
# FFMPEG_PATH=
# FFPROBE_PATH=
