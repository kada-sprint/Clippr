PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
# Copy the Aiven URI locally. URL-encode special characters in the password.
# This project uses Prisma 6: require TLS AND validate certificates.
# sslcert is relative to backend/prisma/, so ../certs/ca.pem is backend/certs/ca.pem.
# Keep the existing shared schema for read-only inspection; do not migrate it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require&sslaccept=strict&sslcert=../certs/ca.pem&connect_timeout=10&socket_timeout=10"
