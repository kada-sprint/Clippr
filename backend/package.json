{
  "name": "cuplik-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend H-01 Cuplik",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=src server.js",
    "start": "node server.js",
    "start:production": "node --max-old-space-size=384 production.js",
    "worker": "node worker.js",
    "worker:dev": "node --watch-path=src worker.js",
    "job:retry": "node scripts/retry-job.js",
    "test": "node --test",
    "test:queue": "node scripts/run-queue-check.js",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-database.js",
    "google:check": "node scripts/check-google.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.5.0",
    "ioredis": "5.11.1",
    "joi": "^18.2.8",
    "multer": "^2.3.0",
    "openai": "^7.12.1"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
